# Build output
/bin/
/dist/
*.exe
/mrti-agent
plugins/ping
plugins/*/*.bin

# Runtime state (never commit real telemetry/creds)
/logs/*
!/logs/.gitkeep
/cache/*
!/cache/.gitkeep

# Local config with real credentials (keep config.yaml.example tracked)
/config.yaml

# Go (dependencias vendorizadas). La copia del kit MRTI-Platform del
# servidor Node sí se versiona, igual que en los demás módulos.
vendor/
!/server/src/vendor/
*.test
*.out

# Demo runtime artifacts
/demo/logs/
/demo/cache/
/demo/config.demo.local.yaml

# Local server deployment (contains API key + agent id)
/run/
