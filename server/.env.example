# Agent Core en Node (Fase 1). Escucha solo en loopback; nginx todavía no lo enruta.
PORT=3007
HOST=127.0.0.1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mrtops
MYSQL_PASSWORD=
MYSQL_DATABASE=mrti_agent_core

# Sesión: se valida reenviando Authorization a MRTI Core (módulo agent-core).
MRTI_CORE_URL=http://127.0.0.1:3005

# Llave que presentan los agentes en X-MRTI-API-Key. Vacía = no se aceptan
# reportes (a diferencia del servidor de Go, que sin llave aceptaba todo).
# En el corte (Fase 4) debe ser la misma llave del servicio mrti-monitor.
AGENT_API_KEY=
